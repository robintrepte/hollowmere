{$HOLLOWMERE_DOMAIN} {
	# Nakama API + realtime socket share the game's origin, so the browser build needs no CORS setup.
	# Not gzipped: the browser already inflates fetches, and Godot's HTTPRequest would inflate twice.
	@nakama path /v2/* /ws /ws/* /healthcheck
	handle @nakama {
		reverse_proxy nakama:7350 {
			header_up -Accept-Encoding
		}
	}

	# Godot web build (threads off, so no cross-origin isolation; COEP would also block Google sign-in).
	handle {
		encode gzip
		root * /srv/site
		# index.pck/index.wasm keep their names across releases, so always revalidate (ETag -> 304).
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
