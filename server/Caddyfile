{$HOLLOWMERE_DOMAIN} {
	# Nakama API + realtime socket share the game's origin, so the browser build needs no CORS setup.
	# Not gzipped: the browser already inflates fetches, and Godot's HTTPRequest would inflate twice.
	@nakama path /v2/* /ws /ws/* /healthcheck
	handle @nakama {
		reverse_proxy nakama:7350 {
			header_up -Accept-Encoding
		}
	}

	# Godot web build (threads off, so no cross-origin isolation; COEP would also block Google sign-in).
	handle {
		encode gzip
		root * /srv/site
		# Engine files are renamed per release to hm-<content hash>.* (tools/release/fingerprint_web.sh),
		# so they never change under a name; only index.html has to be revalidated.
		@fingerprinted path /hm-*
		@page not path /hm-*
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		# The deploy step writes .br/.gz next to the wasm/pck/js (wasm: ~39 MB raw, ~7 MB brotli).
		file_server {
			precompressed br gzip
		}
	}
}
