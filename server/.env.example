# Copy to server/.env (chmod 600, owned by the deploy user; never committed) on the server.
# ecosystem.config.cjs reads it for PM2: hollowmere-nakama gets the NAKAMA_* / TRETU_* keys below
# (server/nakama/run.mjs passes them to Nakama as flags, redacted in the log, never written to a
# file), hollowmere-mcp gets NAKAMA_HTTP_KEY and TRETU_APP_SECRET. Generate every secret with
#   openssl rand -hex 24
# run.mjs refuses to start Nakama while a NAKAMA_* key below is missing, a default or CHANGE_ME, or
# while TRETU_AUTH_ISSUER is missing.

# Nakama binary (HOSTING.md step 4 installs it here).
NAKAMA_BIN=/opt/nakama/nakama

# Database "nakama" on the shared Postgres (HOSTING.md step 3): user:password@host:port/db
NAKAMA_DATABASE_ADDRESS=nakama:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/nakama

# Nakama keys (runtime.http_key, session.*, console.*). The console is only reachable through an
# SSH tunnel; its username must not be "admin".
NAKAMA_HTTP_KEY=CHANGE_ME_HTTP_KEY
NAKAMA_SESSION_ENCRYPTION_KEY=CHANGE_ME_SESSION_KEY
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=CHANGE_ME_REFRESH_KEY
NAKAMA_CONSOLE_USERNAME=hollowmere-ops
NAKAMA_CONSOLE_PASSWORD=CHANGE_ME_CONSOLE_PASSWORD
NAKAMA_CONSOLE_SIGNING_KEY=CHANGE_ME_CONSOLE_SIGNING_KEY

# Tretu (runtime.env of the Lua modules, HOSTING.md step 10).
# Sign-in with the Tretu-Konto, the only account sign-in: REQUIRED.
TRETU_AUTH_ISSUER=https://auth.tretu.de
# Events, presence, Tretu-Credits + notifications (URL and secret must both be set, else off).
# TRETU_APP_SECRET is also the platform webhook secret (POST /api/tretu/webhook, hollowmere-mcp):
# same value as TRETU_APPS_JSON.hollowmere.secret on tretu.de. Empty = webhook off (answers 503).
TRETU_PLATFORM_URL=https://tretu.de
TRETU_APP_ID=hollowmere
TRETU_APP_SECRET=
# Public game URL, used for presence join links to an open co-op farm.
HOLLOWMERE_PUBLIC_URL=https://hollowmere.tretu.de
# After a platform timeout / 5xx, skip tretu.de for this many seconds (0 = never skip).
TRETU_PLATFORM_BACKOFF_SEC=15

# MCP relay (PM2 process hollowmere-mcp).
MCP_PORT=8787
MCP_PUBLIC_URL=https://mcp.hollowmere.tretu.de

# Optional: an extra Nakama YAML (default server/nakama/local.yml, skipped when missing) and the
# data directory (default server/nakama/data). Values above win over the YAML.
# NAKAMA_LOCAL_CONFIG=/srv/hollowmere/server/nakama/local.yml
# NAKAMA_DATA_DIR=/srv/hollowmere/server/nakama/data
