# Copy to server/.env (chmod 600) on the server. Read by ecosystem.config.cjs for PM2.
# Nakama's own secrets live in server/nakama/local.yml (see local.example.yml).

# Nakama binary (HOSTING.md step 4 installs it here).
NAKAMA_BIN=/opt/nakama/nakama

# MCP relay (PM2 process hollowmere-mcp). Must equal runtime.http_key in server/nakama/local.yml.
NAKAMA_HTTP_KEY=change-me-http-key
MCP_PORT=8787
MCP_PUBLIC_URL=https://mcp.hollowmere.tretu.de
