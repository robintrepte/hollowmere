# Copy to .env and fill in real secrets before deploying.
HOLLOWMERE_DOMAIN=play.example.com
POSTGRES_PASSWORD=change-me
# The server key ships inside every client build (it is not a secret); keep it in sync with
# hollowmere/server/key in game/project.godot.
NAKAMA_SERVER_KEY=hollowmere_dev
NAKAMA_SESSION_KEY=change-me-session-key
NAKAMA_REFRESH_KEY=change-me-refresh-key
NAKAMA_HTTP_KEY=change-me-http-key
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me-console
GOOGLE_CLIENT_ID=
